// DeeCodeK Labs — Custom Headless CMS schema
// SQLite for dev (same model works on PostgreSQL for prod — change provider + url in datasource)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  // PostgreSQL for Vercel/production. Local: set DATABASE_URL to a Postgres URL
  // (or temporarily switch provider to "sqlite" for file:./db/custom.db).
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ────────────────────────────────────────────────────────────────────────────
// AUTH & RBAC
// ────────────────────────────────────────────────────────────────────────────

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  name          String?
  passwordHash  String
  role          UserRole       @default(EDITOR)
  image         String?
  isActive      Boolean        @default(true)
  lastLoginAt   DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  pages         Page[]
  blogPosts     BlogPost[]
  media         MediaAsset[]
  contactNotes  ContactNote[]
  auditLogs     AuditLog[]
  revisions     ContentRevision[]
  sessions      Session[]
  accounts      Account[]

  @@index([role])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ────────────────────────────────────────────────────────────────────────────
// PAGES & SECTIONS (Page builder)
// ────────────────────────────────────────────────────────────────────────────

model Page {
  id            String            @id @default(cuid())
  title         String
  slug          String            @unique
  description   String?
  status        ContentStatus     @default(DRAFT)
  pageType      String            @default("custom") // 'homepage' | 'about' | 'custom'
  isHomepage    Boolean           @default(false)
  parentId      String?
  seoId         String?
  seo           SeoMetadata?      @relation(fields: [seoId], references: [id])
  sections      PageSection[]
  updatedById   String?
  updatedBy     User?             @relation(fields: [updatedById], references: [id])
  publishedAt   DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([status])
  @@index([slug])
}

model PageSection {
  id            String   @id @default(cuid())
  pageId        String
  sectionType   String   // 'hero' | 'split_hero' | 'editorial_text' | 'capabilities_grid' ...
  title         String?
  content       String   // JSON string, validated by Zod schema per type
  designVariant String   @default("default")
  themeVariant  String   @default("auto") // 'light' | 'dark' | 'auto'
  sortOrder     Int      @default(0)
  isVisible     Boolean  @default(true)
  config        String?  // JSON string for responsive/extra config
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([pageId, sortOrder])
}

model ContentRevision {
  id         String   @id @default(cuid())
  entityId   String
  entityType String   // 'page' | 'section' | 'blog_post' | 'service' | 'product'
  snapshot   String   // JSON snapshot of the entity at this revision
  revision   Int      @default(1)
  createdById String?
  createdBy  User?    @relation(fields: [createdById], references: [id])
  createdAt  DateTime @default(now())

  @@index([entityId, entityType])
}

// ────────────────────────────────────────────────────────────────────────────
// BUSINESS: SERVICES, PRODUCTS, PORTFOLIO
// ────────────────────────────────────────────────────────────────────────────

model Service {
  id            String       @id @default(cuid())
  title         String
  slug          String       @unique
  summary       String?
  description   String?
  richContent   String?      // markdown / html
  icon          String?      // lucide icon name
  imageUrl      String?
  technologies  String       // JSON array string
  capabilities  String       // JSON array string
  isFeatured    Boolean      @default(false)
  sortOrder     Int          @default(0)
  status        ContentStatus @default(DRAFT)
  seoId         String?
  seo           SeoMetadata? @relation(fields: [seoId], references: [id])
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([status])
}

model Product {
  id            String       @id @default(cuid())
  name          String
  slug          String       @unique
  tagline       String?
  category      String?
  summary       String?
  description   String?
  richContent   String?
  status        String       @default("in_development") // 'coming_soon' | 'in_development' | 'launched' | 'archived'
  coverImage    String?
  gallery       String       // JSON array of image URLs
  technologies  String       // JSON array
  features      ProductFeature[]
  externalUrl   String?
  isFeatured    Boolean      @default(false)
  sortOrder     Int          @default(0)
  seoId         String?
  seo           SeoMetadata? @relation(fields: [seoId], references: [id])
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([status])
}

model ProductFeature {
  id        String  @id @default(cuid())
  productId String
  title     String
  description String?
  sortOrder Int     @default(0)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model Project {
  id             String       @id @default(cuid())
  name           String
  slug           String       @unique
  category       String?
  summary        String?
  description    String?
  caseStudy      String?
  coverImage     String?
  gallery        String       // JSON array
  technologies   String       // JSON array
  projectUrl     String?
  isFeatured     Boolean      @default(false)
  completionDate DateTime?
  status         ContentStatus @default(DRAFT)
  seoId          String?
  seo            SeoMetadata? @relation(fields: [seoId], references: [id])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([status])
}

// ────────────────────────────────────────────────────────────────────────────
// BLOG
// ────────────────────────────────────────────────────────────────────────────

model BlogPost {
  id           String       @id @default(cuid())
  title        String
  slug         String       @unique
  excerpt      String?
  content      String?      // markdown
  coverImage   String?
  readingMinutes Int        @default(5)
  status       ContentStatus @default(DRAFT)
  featured     Boolean      @default(false)
  publishedAt  DateTime?
  authorId     String?
  author       User?        @relation(fields: [authorId], references: [id])
  categoryId   String?
  category     BlogCategory? @relation(fields: [categoryId], references: [id])
  tags         BlogPostTag[]
  seoId        String?
  seo          SeoMetadata? @relation(fields: [seoId], references: [id])
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([status])
  @@index([publishedAt])
  @@index([categoryId])
}

model BlogCategory {
  id        String     @id @default(cuid())
  name      String
  slug      String     @unique
  description String?
  posts     BlogPost[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([slug])
}

model BlogTag {
  id        String       @id @default(cuid())
  name      String
  slug      String       @unique
  posts     BlogPostTag[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([slug])
}

model BlogPostTag {
  postId String
  tagId  String
  post   BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag    BlogTag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
}

// ────────────────────────────────────────────────────────────────────────────
// MEDIA LIBRARY
// ────────────────────────────────────────────────────────────────────────────

model MediaAsset {
  id             String   @id @default(cuid())
  filename       String   // stored filename
  originalName   String
  mimeType       String
  size           Int
  width          Int?
  height         Int?
  altText        String?
  description    String?
  storageKey     String   // path / key
  url            String   // public URL
  uploadedById   String?
  uploadedBy     User?    @relation(fields: [uploadedById], references: [id])
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([mimeType])
}

// ────────────────────────────────────────────────────────────────────────────
// NAVIGATION & SETTINGS
// ────────────────────────────────────────────────────────────────────────────

model NavigationMenu {
  id        String           @id @default(cuid())
  name      String           // 'header' | 'footer' | 'mobile'
  slug      String           @unique
  items     NavigationItem[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
}

model NavigationItem {
  id        String           @id @default(cuid())
  menuId    String
  label     String
  url       String
  parentId  String?
  sortOrder Int              @default(0)
  isNewTab  Boolean          @default(false)
  isButton  Boolean          @default(false)
  menu      NavigationMenu   @relation(fields: [menuId], references: [id], onDelete: Cascade)

  @@index([menuId, sortOrder])
}

model SiteSetting {
  id    String @id @default(cuid())
  key   String @unique
  value String // JSON-encoded value

  @@index([key])
}

model SeoMetadata {
  id                String   @id @default(cuid())
  metaTitle         String?
  metaDescription   String?
  canonicalUrl      String?
  ogTitle           String?
  ogDescription     String?
  ogImage           String?
  robotsIndex       Boolean  @default(true)
  robotsFollow      Boolean  @default(true)
  structuredData    String?  // JSON string (custom JSON-LD)
  focusKeyword      String?
  secondaryKeywords String?
  schemaType        String?  // e.g. Article, Service, Product, WebPage, FAQPage, custom
  breadcrumbLabel   String?
  includeInSitemap  Boolean  @default(true)
  seoScore          Int?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  pages     Page[]
  services  Service[]
  products  Product[]
  projects  Project[]
  posts     BlogPost[]
}

model Redirect {
  id         String   @id @default(cuid())
  fromPath   String   @unique
  toPath     String
  statusCode Int      @default(301)
  isActive   Boolean  @default(true)
  hitCount   Int      @default(0)
  createdAt  DateTime @default(now())
}

model NotFoundHit {
  id           String   @id @default(cuid())
  path         String   @unique
  count        Int      @default(1)
  lastReferrer String?
  updatedAt    DateTime @updatedAt
  createdAt    DateTime @default(now())

  @@index([count])
  @@index([updatedAt])
}

// ────────────────────────────────────────────────────────────────────────────
// TESTIMONIALS & FAQS
// ────────────────────────────────────────────────────────────────────────────

model Testimonial {
  id         String   @id @default(cuid())
  authorName String
  authorRole String?
  authorCompany String?
  avatarUrl  String?
  content    String
  rating     Int      @default(5)
  isFeatured Boolean  @default(false)
  sortOrder  Int      @default(0)
  status     ContentStatus @default(PUBLISHED)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Faq {
  id        String   @id @default(cuid())
  question String
  answer   String
  category String?
  sortOrder Int      @default(0)
  status   ContentStatus @default(PUBLISHED)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ────────────────────────────────────────────────────────────────────────────
// CONTACT SUBMISSIONS
// ────────────────────────────────────────────────────────────────────────────

model ContactSubmission {
  id          String   @id @default(cuid())
  name        String
  email       String
  service     String?
  budget      String?
  message     String
  status      ContactStatus @default(NEW)
  ipAddress   String?
  userAgent   String?
  assignedToId String?
  notes       ContactNote[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
}

model ContactNote {
  id          String   @id @default(cuid())
  submissionId String
  authorId    String?
  author      User?    @relation(fields: [authorId], references: [id])
  content     String
  createdAt   DateTime @default(now())
  submission  ContactSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([submissionId])
}

// ────────────────────────────────────────────────────────────────────────────
// AUDIT LOG
// ────────────────────────────────────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  action     String   // 'create' | 'update' | 'delete' | 'publish' | 'login' ...
  entityType String
  entityId   String?
  metadata   String?  // JSON string
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([userId])
}

// ────────────────────────────────────────────────────────────────────────────
// ENUMS (SQLite doesn't support native enums — these are string-backed)
// ────────────────────────────────────────────────────────────────────────────

enum UserRole {
  SUPER_ADMIN
  ADMIN
  EDITOR
  VIEWER
}

enum ContentStatus {
  DRAFT
  IN_REVIEW
  PUBLISHED
  SCHEDULED
  ARCHIVED
}

enum ContactStatus {
  NEW
  READ
  IN_PROGRESS
  REPLIED
  CLOSED
  SPAM
}
